{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "route-atlas-bgp",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "routes": [
    { "pattern": "bgp.thanejoss.com/api/bgp/*", "zone_name": "thanejoss.com" }
  ],
  "vars": {
    "APP_ORIGIN": "https://bgp.thanejoss.com"
  },
  "r2_buckets": [
    { "binding": "BGP_BUCKET", "bucket_name": "route-atlas-bgp" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
