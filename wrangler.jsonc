{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bgp",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "bgp.thanejoss.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
